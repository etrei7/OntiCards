+test('remaining indexing timeout terminates a real subprocess through the existing executor', async () => {
+  process.env.ONTICARDS_MAINTENANCE_MODE = '1';
+  process.env.INDEXING_RUN_TIMEOUT_MS = '400';
+  await withIndexingRunBudget('fixture/repo', 'main', async () => {
+    const remaining = await reserveIndexingAnalysis();
+    const started = Date.now();
+    const result = await executeDockerCommand(process.execPath,
+      ['-e', 'console.log(process.pid); setInterval(() => {}, 1000)'],
+      { timeout: remaining, preserveOutputOnTimeout: true });
+    assert.equal(result.timedOut, true);
+    assert.ok(Date.now() - started < 5000);
+    const pid = Number(result.stdout.trim().split('\n')[0]);
+    assert.ok(Number.isInteger(pid) && pid > 1);
+    assert.throws(() => process.kill(pid, 0), (error: any) => error.code === 'ESRCH', 'the child actually terminated; this is not a Promise-only timeout');
+  });
+});
