+const root = await mkdtemp(path.join(tmpdir(), 'indexing-budget-'));
+process.env.NODE_ENV = 'test';
+process.env.DATA_DIR = path.join(root, 'data');
+process.env.ONTICARDS_MAINTENANCE_MODE = '1';
+let cancelled = false;
+await mock.module('ioredis', { namedExports: { Redis: class {
+  async get() { return cancelled ? '1' : null; } async set() {} async del() {} on() {} async quit() {} disconnect() {}
+} } });
+const budget = await import('../packages/core/src/services/relevance/indexingCancellation.js');
+// Baseline has no run boundary: exercise the actual original batch functions for red.
+const withBudget = budget.withIndexingRunBudget ?? ((_repo: string, _branch: string, action: () => Promise<unknown>) => action());
+const { db, runMigrations, closeConnection } = await import('../packages/core/src/db/connection.js');
+const { processSingleBatch } = await import('../packages/core/src/services/relevance/summaryMinerBatch.js');
+const { processDirectoryBatch } = await import('../packages/core/src/services/relevance/summaryMinerDirectoryBatch.js');
+const log = { info() {}, debug() {}, warn() {}, error() {} } as any;
+let calls: any[] = [];
+let invalid = false;
+let cancelAfterFirst = false;
+const agent = { config: { alias: 'fixture', type: 'opencode', defaultModel: 'fixture', enabled: true },
+  analyze: async (_prompt: string, options: any) => {
+    calls.push(options);
+    if (cancelAfterFirst) cancelled = true;
+    return { success: true, response: invalid ? '{}' : JSON.stringify({ summaries: [
+      { path: options.metadata.phase === 'directory_aggregation' ? 'fixture/repo/src' : 'src/a.ts', summary: 'Fixture source summary.' },
+    ] }), modelUsed: 'fixture', executionTimeMs: 1 };
+  },
+} as any;
