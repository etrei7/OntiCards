+import assert from 'node:assert/strict';
+import { after, test } from 'node:test';
+import { buildPrTemplateValues, closeConnection, generateCompletionCommentParts } from '@propr/core';
+import { createPullRequest } from '../src/jobs/issueJobHelpers.js';
+import { generatePRBody, generateClaudeLogsComment } from '../src/github/prFormatters.js';
+
+after(() => closeConnection());
+
+async function mode<T>(value: string | undefined, run: () => Promise<T>): Promise<T> {
+    const previous = process.env.ONTICARDS_MAINTENANCE_MODE;
+    if (value === undefined) delete process.env.ONTICARDS_MAINTENANCE_MODE;
+    else process.env.ONTICARDS_MAINTENANCE_MODE = value;
+    try { return await run(); }
+    finally {
+        if (previous === undefined) delete process.env.ONTICARDS_MAINTENANCE_MODE;
+        else process.env.ONTICARDS_MAINTENANCE_MODE = previous;
+    }
+}
+
+test('maintenance issue publishing requests a draft at the actual GitHub boundary', async () => {
+    for (const [flag, expectedDraft] of [['1', true], [undefined, false]] as const) {
+        await mode(flag, async () => {
+            const posted: Record<string, unknown>[] = [];
+            const octokit = { async request(endpoint: string, options: Record<string, unknown>) {
+                if (endpoint === 'GET /repos/{owner}/{repo}/commits/{ref}') return {data: {sha: 'a'.repeat(40)}};
+                if (endpoint.startsWith('GET ')) throw Object.assign(new Error('No template'), {status: 404});
+                if (endpoint === 'POST /repos/{owner}/{repo}/pulls') {
+                    posted.push(options);
+                    return {data: {number: 33, html_url: 'https://github.com/acme/app/pull/33', title: options.title}};
+                }
+                if (endpoint === 'POST /repos/{owner}/{repo}/issues/{issue_number}/labels') return {data: []};
+                throw new Error('Unexpected GitHub operation: ' + endpoint);
+            }};
+            const logger = {info() {}, warn() {}, error() {}, debug() {}};
+            await createPullRequest(octokit as never, {repoOwner: 'acme', repoName: 'app', number: 32, baseBranch: 'main'} as never,
+                {branchName: 'codex/fix-conversion'} as never, {
+                    commitResult: null, claudeResult: null, modelName: 'bailian/qwen3.8-max-0902', repoValidation: {} as never,
+                    PR_LABEL: 'propr', correlatedLogger: logger as never, issueTitle: 'Isolate profile',
+                });
+            assert.equal(posted.length, 1);
+            assert.equal(posted[0].draft, expectedDraft);
+            assert.equal(posted[0].base, 'main');
+            if (expectedDraft) assert.match(String(posted[0].body), /API cost: unknown/);
+        });
+    }
+});
+
+test('provider cost absence and OpenCode default zero stay unknown in all native public formats', async () => mode('1', async () => {
+    for (const finalResult of [{}, {cost_usd: 0}, {cost_usd: NaN}, {cost_usd: -1}]) {
+        const result = {success: true, model: 'bailian/qwen3.8-max-0902', finalResult,
+            tokenUsage: {input_tokens: 123, output_tokens: 4, cache_read_input_tokens: 99}};
+        const completion = await generateCompletionCommentParts(result, {repoOwner: 'acme', repoName: 'app', number: 32});
+        assert.equal(completion.stats.cost, null);
+        assert.match(completion.run, /API cost: unknown \(provider billing not available\)/);
+        assert.doesNotMatch(completion.run, /\$0\.00/);
+        assert.equal(buildPrTemplateValues({cost: completion.stats.cost}).cost, 'unknown (provider billing not available)');
+        for (const text of [await generatePRBody(32, 'Profile isolation', 'fix profile', result), await generateClaudeLogsComment(result, 32)]) {
+            assert.match(text, /\*\*API cost\*\*: unknown/);
+            assert.doesNotMatch(text, /\$0\.00/);
+        }
+    }
+}));
+
+test('positive reported cost remains distinct from missing provider billing', async () => mode('1', async () => {
+    const result = {success: true, finalResult: {cost_usd: 0.42}};
+    const completion = await generateCompletionCommentParts(result, {repoOwner: 'acme', repoName: 'app', number: 32});
+    assert.equal(completion.stats.cost, 0.42);
+    assert.match(completion.run, /API cost: \$0\.42/);
+    assert.equal(buildPrTemplateValues({cost: completion.stats.cost}).cost, '$0.42');
+}));
