@@ -0,0 +1,25 @@
+import { humanMergeOnly, type StoredAgentRun } from '@propr/core';
+
+/** OntiCards-only output gate; native AgentRun state/storage still owns the lifecycle. */
+export function dailyReportFailure(run: StoredAgentRun, report: string): string | null {
+    const definitionId = process.env.ONTICARDS_DAILY_DEFINITION_ID?.trim();
+    if (!humanMergeOnly() || !definitionId || run.definitionId !== definitionId) return null;
+    const heading = report.trimStart().split(/\r?\n/, 1)[0].replace(/^#{1,6}\s*/, '');
+    if (/^【AI辅助】日报(?:等待事实数据|输入校验失败)/.test(heading)) {
+        return 'DAILY_FACTS_UNAVAILABLE_OR_INVALID: 本次未生成合格日报；请检查事实采集并手动补报。';
+    }
+    // Use the native trigger time, matching the existing Python input contract.
+    const parts = new Intl.DateTimeFormat('en-CA', {
+        timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
+    }).formatToParts(new Date(run.createdAt));
+    const number = (type: string) => Number(parts.find(part => part.type === type)?.value);
+    const day = new Date(Date.UTC(number('year'), number('month') - 1, number('day')) - 86400000)
+        .toISOString().slice(0, 10);
+    if (!report.includes('【AI辅助】OntiCards 中文维护日报') || !report.includes(day)
+        || !report.includes(run.id)
+        || !['A', 'B', 'C', 'D', 'E', 'F'].every(section =>
+            new RegExp(`^\\s*(?:#{1,6}\\s*)?(?:\\*\\*)?${section}(?:\\s|[.、：:])`, 'm').test(report))) {
+        return 'DAILY_REPORT_CONTRACT_INVALID: 日报缺少目标日期、运行编号或完整 A—F 章节；原输出已保留。';
+    }
+    return null;
+}
