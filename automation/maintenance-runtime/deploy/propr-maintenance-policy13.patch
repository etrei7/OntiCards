+++ b/test/indexingPreparationDeadline.test.ts
@@ -0,0 +1,123 @@
+import assert from 'node:assert/strict';
+import { after, mock, test } from 'node:test';
+import http from 'node:http';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { setTimeout as delay } from 'node:timers/promises';
+import { createHooklessGit, withGitPreparation } from '../packages/core/src/git/hooklessGit.js';
+
+const previousMode = process.env.ONTICARDS_MAINTENANCE_MODE;
+process.env.ONTICARDS_MAINTENANCE_MODE = '1';
+after(() => { if (previousMode === undefined) delete process.env.ONTICARDS_MAINTENANCE_MODE; else process.env.ONTICARDS_MAINTENANCE_MODE = previousMode; });
+const queued: unknown[] = [];
+let prepare: () => Promise<string>;
+let fetch: () => Promise<{ success: boolean; repoPath: string; error?: string }>;
+let wrapperCalls: number[] = [];
+const idleRedis = () => ({ get: async () => null, del: async () => {}, quit: async () => {}, disconnect() {} });
+const queue = { getJobs: async () => [], add: async (_name: string, data: unknown) => { queued.push(data); return { id: 'fixture-job' }; } };
+const logger = { info() {}, warn() {}, error() {}, debug() {}, fatal() {}, withCorrelation() { return this; } };
+await mock.module('@propr/core', { namedExports: {
+  getIndexingQueue: async () => queue, indexingQueue: queue,
+  generateCorrelationId: () => 'fixture-correlation',
+  ensureRepoCloned: async () => prepare(), getRepoUrl: () => 'https://example.invalid/fixture/repo',
+  getAuthenticatedOctokit: async () => ({ auth: async () => ({ token: 'fixture-no-credential' }) }),
+  updateRepositoryStatus: async () => {}, requestIndexingCancellation: async () => {},
+  fetchLatestChanges: async () => fetch(),
+  withGitPreparation: async (id: string, operation: () => Promise<unknown>, options: { timeoutMs?: number }) => {
+    wrapperCalls.push(options.timeoutMs!);
+    return withGitPreparation(id, operation, { ...options, timeoutMs: 700, redisFactory: idleRedis, pollIntervalMs: 20 });
+  },
+  humanMergeOnly: () => process.env.ONTICARDS_MAINTENANCE_MODE === '1',
+  loadSummarizationSettings: async () => ({ enabled: true, agent_alias: 'fixture' }),
+  getSummarizationCooldown: async () => null,
+  normalizeSummarizationBranch: (value?: string) => value?.trim() || 'HEAD',
+  loadMonitoredReposRaw: async () => [{ id: 'fixture', name: 'fixture/repo', enabled: true, baseBranch: 'main' }],
+  db: () => ({ where: () => ({ first: async () => undefined }) }),
+  createWorker: async () => { throw new Error('Do not start worker in acceptance test'); },
+  INDEXING_QUEUE_NAME: 'fixture', runMigrations: async () => {}, logger,
+  startEgressProxySweeper: () => { throw new Error('Do not start proxy in acceptance test'); },
+  indexRepo: async () => { throw new Error('No model or indexing in admission test'); },
+} });
+await mock.module('../src/jobs/networkEgress.js', { namedExports: { runWithNetworkPolicy: async () => { throw new Error('No job execution'); } } });
+await mock.module('../src/jobs/networkEgressSafetyNet.js', { namedExports: { enforceInstanceNetworkPolicyOutsideRuns: () => {} } });
+const { queueIndexingJob, queueResummarizationForAllRepos } = await import('../packages/api/routes/indexingQueueHelpers.js');
+const { scanAndQueueRepositories } = await import('../src/indexing_worker.js');
+
+type Row = { pid: number; ppid: number; state: string; comm: string };
+async function processRows(): Promise<Row[]> {
+  const rows: Row[] = [];
+  for (const name of await fs.readdir('/proc')) {
+    if (!/^\d+$/.test(name)) continue;
+    try {
+      const text = await fs.readFile(`/proc/${name}/stat`, 'utf8');
+      const end = text.lastIndexOf(')'); const fields = text.slice(end + 2).split(' ');
+      rows.push({ pid: Number(name), ppid: Number(fields[1]), state: fields[0], comm: text.slice(text.indexOf('(') + 1, end) });
+    } catch { /* process exited during observation */ }
+  }
+  return rows;
+}
+function descendants(rows: Row[]): Row[] {
+  const pids = new Set([process.pid]); let changed = true;
+  while (changed) { changed = false; for (const row of rows) if (pids.has(row.ppid) && !pids.has(row.pid)) { pids.add(row.pid); changed = true; } }
+  return rows.filter(row => row.pid !== process.pid && pids.has(row.pid));
+}
+async function stalledPreparation(entry: 'manual' | 'batch' | 'periodic', phase: 'clone' | 'fetch') {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'index-prepare-deadline-'));
+  await createHooklessGit(root).init();
+  const sockets = new Set<import('node:net').Socket>();
+  const ready = Promise.withResolvers<void>();
+  const server = http.createServer(() => ready.resolve());
+  server.on('connection', socket => { sockets.add(socket); socket.on('close', () => sockets.delete(socket)); });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  const url = `http://127.0.0.1:${(server.address() as import('node:net').AddressInfo).port}/source.git`;
+  queued.length = 0; wrapperCalls = [];
+  let fetchError: string | undefined;
+  let stage = 'not-started';
+  prepare = async () => {
+    stage = 'preparing';
+    if (phase === 'clone') await createHooklessGit().clone(url, path.join(root, 'clone'));
+    else await delay(200); // Preparation time must be deducted from the same fetch deadline.
+    stage = 'prepared';
+    return root;
+  };
+  fetch = async () => {
+    stage = 'fetching';
+    try { if (phase === 'fetch') await createHooklessGit(root).raw(['fetch', url]); return { success: true, repoPath: root }; }
+    catch (error) { fetchError = (error as Error).message; return { success: false, repoPath: root, error: 'fixture fetch aborted' }; }
+  };
+  let observed: Row[] = [];
+  const start = performance.now();
+  const operation = (entry === 'manual' ? queueIndexingJob('fixture/repo', false, 'main')
+    : entry === 'batch' ? queueResummarizationForAllRepos() : scanAndQueueRepositories())
+    .then(value => ({ done: true, value }), error => ({ done: true, error }));
+  let completed: unknown;
+  void operation.then(value => { completed = value; });
+  try {
+    await Promise.race([ready.promise, delay(1800).then(() => { throw new Error('No real Git HTTP request: ' + JSON.stringify({stage,fetchError,wrapperCalls,completed})); })]);
+    observed = descendants(await processRows()).filter(row => row.comm === 'git' || row.comm.startsWith('git-'));
+    assert.ok(observed.some(row => row.comm.startsWith('git-remote-')), 'real Git HTTP child required');
+    const result = await Promise.race([operation, delay(1600).then(() => ({ done: false }))]);
+    assert.equal(result.done, true, 'entry must await actual Git termination within its preparation budget');
+    await delay(30);
+    assert.deepEqual((await processRows()).filter(row => observed.some(old => old.pid === row.pid) && row.state !== 'Z'), []);
+    assert.deepEqual(wrapperCalls, [120000], 'one existing wrapper must cover clone and fresh fetch together');
+    assert.equal(queued.length, 0);
+    assert.ok(performance.now() - start < 1700);
+    if ('value' in result && entry === 'manual') assert.equal((result.value as any).success, false);
+    if ('value' in result && entry === 'batch') assert.equal((result.value as any).failedClone, 1);
+  } finally {
+    for (const row of (await processRows()).filter(row => observed.some(old => old.pid === row.pid) && row.state !== 'Z').reverse()) {
+      try { process.kill(row.pid, 'SIGTERM'); } catch { /* exited */ }
+    }
+    for (const socket of sockets) socket.destroy();
+    await new Promise<void>(resolve => server.close(() => resolve()));
+    await operation;
+    await fs.rm(root, { recursive: true, force: true });
+  }
+}
+for (const entry of ['manual', 'batch', 'periodic'] as const) {
+  for (const phase of ['clone', 'fetch'] as const) {
+    test(`${entry} indexing bounds a real stalled ${phase} child and refuses enqueue`, () => stalledPreparation(entry, phase));
+  }
+}
