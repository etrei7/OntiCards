+import assert from 'node:assert/strict';
+import { after, beforeEach, mock, test } from 'node:test';
+import { Worker, UnrecoverableError, type Job } from 'bullmq';
+
+// Must run against an isolated real Redis. No skipped fallback, model, or GitHub access.
+Object.assign(process.env, {
+  ONTICARDS_MAINTENANCE_MODE: '1',
+  INDEXING_QUEUE_NAME: `index-budget-test-${process.pid}-${Date.now()}`,
+  GITHUB_ISSUE_QUEUE_NAME: `index-budget-issues-${process.pid}-${Date.now()}`,
+});
+const connection = { host: process.env.REDIS_HOST || '127.0.0.1', port: Number(process.env.REDIS_PORT || 6379), maxRetriesPerRequest: null };
+const nativeQueue = await import('../packages/core/src/queue/taskQueue.js');
+let outcome: string | undefined = 'completed';
+let indexCalls = 0;
+let enabled = true;
+let failure: Error | undefined;
+const log = { info() {}, warn() {}, error() {}, debug() {}, fatal() {}, withCorrelation() { return this; } };
+await mock.module('@propr/core', { namedExports: {
+  createWorker: async () => { throw new Error('No long-running application worker in tests'); },
+  INDEXING_QUEUE_NAME: process.env.INDEXING_QUEUE_NAME, indexingQueue: {}, runMigrations: async () => {},
+  logger: log, startEgressProxySweeper: () => {}, generateCorrelationId: () => 'fixture',
+  db: (table: string) => { assert.equal(table, 'repositories'); return { where: (query: unknown) => {
+    assert.deepEqual(query, { full_name: 'fixture/repo', branch: 'main' });
+    return { first: async () => outcome ? { indexing_status: outcome } : undefined };
+  } }; },
+  indexRepo: async () => { indexCalls++; if (failure) throw failure; },
+  updateRepositoryStatus: async () => {}, loadSummarizationSettings: async () => ({ enabled }),
+  loadMonitoredReposRaw: async () => [], humanMergeOnly: () => process.env.ONTICARDS_MAINTENANCE_MODE === '1',
+  ensureRepoCloned: async () => '', getRepoUrl: () => '', getAuthenticatedOctokit: async () => ({}),
+  fetchLatestChanges: async () => ({ success: true }), withGitPreparation: async (_id: string, action: () => Promise<unknown>) => action(),
+} });
+await mock.module('../src/jobs/networkEgress.js', { namedExports: { runWithNetworkPolicy: async (_options: unknown, action: () => Promise<unknown>) => action() } });
+await mock.module('../src/jobs/networkEgressSafetyNet.js', { namedExports: { enforceInstanceNetworkPolicyOutsideRuns: () => {} } });
+const { processIndexingJob } = await import('../src/indexing_worker.js');
+const data = { repository: 'fixture/repo', repoPath: '/fixture', correlationId: 'fixture', baseBranch: 'main', priority: 'normal' as const };
+beforeEach(() => { process.env.ONTICARDS_MAINTENANCE_MODE = '1'; outcome = 'completed'; indexCalls = 0; enabled = true; failure = undefined; });
+after(async () => { await (await nativeQueue.getIndexingQueue()).obliterate({ force: true }); await (await nativeQueue.getIssueQueue()).obliterate({ force: true }); await nativeQueue.shutdownQueue(); });
+
+async function settle(job: Job) {
+  for (let i = 0; i < 160; i++) {
+    const state = await job.getState();
+    if (state === 'completed' || state === 'failed') return state;
+    await new Promise(resolve => setTimeout(resolve, 25));
+  }
+  throw new Error('Isolated BullMQ job did not reach a terminal state');
+}
+
+test('maintenance native queue persists attempts=1 while the issue queue retains attempts=3', async () => {
+  const queue = await nativeQueue.getIndexingQueue();
+  const job = await queue.add('indexRepository', data);
+  assert.equal((await queue.getJob(job.id!))?.opts.attempts, 1);
+  assert.equal((await nativeQueue.getIssueQueue()).defaultJobOptions.attempts, 3);
+  await job.remove();
+});
+
+test('non-maintenance indexing queue retains its upstream attempts=3', async () => {
+  await nativeQueue.shutdownQueue(); process.env.ONTICARDS_MAINTENANCE_MODE = '0';
+  assert.equal((await nativeQueue.getIndexingQueue()).defaultJobOptions.attempts, 3);
+  await nativeQueue.shutdownQueue();
+});
+
+test('an old attempts=3 job budget failure ends failed after one actual BullMQ invocation', async () => {
+  failure = Object.assign(new Error('Indexing run allowance exhausted'), { name: 'IndexingRunBudgetExceeded' });
+  const queue = await nativeQueue.getIndexingQueue();
+  const job = await queue.add('indexRepository', data, { attempts: 3, backoff: { type: 'fixed', delay: 20 } });
+  const worker = new Worker(queue.name, processIndexingJob, { connection, concurrency: 1 });
+  try {
+    assert.equal(await settle(job), 'failed');
+    assert.equal(indexCalls, 1); assert.equal((await queue.getJob(job.id!))?.attemptsMade, 1);
+    assert.equal(await queue.getDelayedCount(), 0);
+  } finally { await worker.close(); await job.remove(); }
+});
+
+test('an already-failed legacy job cannot restart indexRepo when its native retry is delivered', async () => {
+  const queue = await nativeQueue.getIndexingQueue(); let calls = 0;
+  const job = await queue.add('indexRepository', data, { attempts: 3, backoff: { type: 'fixed', delay: 20 } });
+  const worker = new Worker(queue.name, async current => {
+    if (++calls === 1) throw new Error('fixture legacy first attempt failed');
+    return processIndexingJob(current);
+  }, { connection, concurrency: 1 });
+  try {
+    assert.equal(await settle(job), 'failed'); assert.equal(calls, 2); assert.equal(indexCalls, 0);
+    assert.equal((await queue.getJob(job.id!))?.attemptsMade, 2);
+  } finally { await worker.close(); await job.remove(); }
+});
+
+test('a stalled/redelivered attempt is rejected before analysis even without a failed attempt', async () => {
+  await assert.rejects(processIndexingJob({ data, attemptsMade: 0, attemptsStarted: 2 } as Job), UnrecoverableError);
+  assert.equal(indexCalls, 0);
+});
+
+test('native failed repository state cannot be projected as completed', async () => {
+  outcome = 'failed';
+  const queue = await nativeQueue.getIndexingQueue();
+  const job = await queue.add('indexRepository', data, { attempts: 3, backoff: { type: 'fixed', delay: 20 } });
+  const worker = new Worker(queue.name, processIndexingJob, { connection, concurrency: 1 });
+  try { assert.equal(await settle(job), 'failed'); assert.equal(indexCalls, 1); }
+  finally { await worker.close(); await job.remove(); }
+});
+
+test('completed native repository state remains a successful result', async () => {
+  const result = await processIndexingJob({ data, attemptsMade: 0, attemptsStarted: 1 } as Job);
+  assert.equal(result.status, 'completed'); assert.equal(result.success, true); assert.equal(indexCalls, 1);
+});
+
+test('idle cancellation or cooldown is reported as an explicit skip, never a completed index', async () => {
+  outcome = 'idle';
+  const result = await processIndexingJob({ data, attemptsMade: 0, attemptsStarted: 1 } as Job);
+  assert.equal(result.status, 'skipped'); assert.equal(result.success, false);
+});
+
+test('missing or unfinished repository status cannot prove completion', async () => {
+  for (outcome of [undefined, 'indexing']) {
+    await assert.rejects(processIndexingJob({ data, attemptsMade: 0, attemptsStarted: 1 } as Job), UnrecoverableError);
+  }
+});
+
+test('upstream non-maintenance retry and completion behavior is unchanged', async () => {
+  process.env.ONTICARDS_MAINTENANCE_MODE = '0'; outcome = 'failed';
+  assert.equal((await processIndexingJob({ data, attemptsMade: 1, attemptsStarted: 2 } as Job)).status, 'completed');
+  assert.equal(indexCalls, 1);
+});
+
+test('a disabled summarizer performs no index call', async () => {
+  enabled = false;
+  assert.equal((await processIndexingJob({ data, attemptsMade: 0, attemptsStarted: 1 } as Job)).status, 'skipped');
+  assert.equal(indexCalls, 0);
+});
