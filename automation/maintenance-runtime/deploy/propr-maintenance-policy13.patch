+import assert from 'node:assert/strict';
+import { after, afterEach, beforeEach, test } from 'node:test';
+import express from 'express';
+import session from 'express-session';
+import { closeConnection } from '@propr/core';
+import { getInsecureSessionOrigin } from '../authInternalHttp.js';
+import { getValidatedRedirectTo } from '../authRedirect.js';
+import { clearSessionCookie, shouldUseSecureSessionCookie } from '../authSession.js';
+
+const keys = ['AUTH_INSECURE_SESSION_ORIGIN', 'API_PUBLIC_URL', 'FRONTEND_URL', 'COOKIE_DOMAIN',
+    'NODE_ENV', 'AUTH_ALLOW_HTTP_REDIRECT', 'AUTH_REDIRECT_ALLOWED_HOSTS'];
+const original = new Map(keys.map(key => [key, process.env[key]]));
+const origin = 'http://10.66.66.5:18123';
+function configure(value = origin): void {
+    process.env.AUTH_INSECURE_SESSION_ORIGIN = value;
+    process.env.API_PUBLIC_URL = value;
+    process.env.FRONTEND_URL = value;
+}
+beforeEach(() => {
+    for (const key of keys) delete process.env[key];
+    process.env.NODE_ENV = 'production';
+    process.env.AUTH_ALLOW_HTTP_REDIRECT = 'true';
+    configure();
+});
+afterEach(() => {
+    for (const [key, value] of original) {
+        if (value === undefined) delete process.env[key];
+        else process.env[key] = value;
+    }
+});
+after(async () => { await closeConnection(); });
+
+test('HTTP production cookie remains Secure without the explicit session opt-in', () => {
+    delete process.env.AUTH_INSECURE_SESSION_ORIGIN;
+    assert.equal(shouldUseSecureSessionCookie(undefined), true);
+});
+test('one canonical private origin permits HTTP sessions and same-origin paths only', () => {
+    assert.equal(getInsecureSessionOrigin(), origin);
+    assert.equal(shouldUseSecureSessionCookie(undefined), false);
+    assert.equal(getValidatedRedirectTo(origin + '/tasks?view=recent'), origin + '/tasks?view=recent');
+    assert.equal(getValidatedRedirectTo('http://10.66.66.5:18124/tasks'), undefined);
+    assert.equal(getValidatedRedirectTo('http://10.66.66.6:18123/tasks'), undefined);
+    assert.equal(getValidatedRedirectTo('http://user@10.66.66.5:18123/tasks'), undefined);
+});
+test('mismatched configuration and domain cookies cannot enable HTTP sessions', () => {
+    process.env.FRONTEND_URL = 'http://10.66.66.5:18124';
+    assert.equal(shouldUseSecureSessionCookie(undefined), true);
+    assert.equal(getValidatedRedirectTo(origin), undefined);
+    configure();
+    process.env.API_PUBLIC_URL = 'https://10.66.66.5:18123';
+    assert.equal(shouldUseSecureSessionCookie(undefined), true);
+    configure();
+    assert.equal(shouldUseSecureSessionCookie('10.66.66.5'), true);
+    process.env.COOKIE_DOMAIN = '10.66.66.5';
+    assert.equal(getInsecureSessionOrigin(), undefined);
+});
+test('public, noncanonical, alternate-protocol and ambiguous URLs fail closed', () => {
+    for (const value of ['http://8.8.8.8:18123', 'http://172.32.0.1:18123',
+        'http://10.66.66.5:18123/', 'http://10.66.66.5:18123?x=1',
+        'http://10.66.66.5:18123#fragment', 'http://user:secret@10.66.66.5:18123',
+        'http://0x0a424205:18123', 'http://10.66.66.5:018123',
+        ' http://10.66.66.5:18123', 'http://internal.example:18123',
+        'https://10.66.66.5:18123', 'http://[fd00::1]:18123']) {
+        configure(value);
+        assert.equal(getInsecureSessionOrigin(), undefined, value);
+        assert.equal(shouldUseSecureSessionCookie(undefined), true, value);
+    }
+});
+test('express-session sets and clears HttpOnly Lax cookies over the configured HTTP deployment', async () => {
+    const app = express();
+    app.use(session({ secret: 'isolated-test-secret-32-characters-minimum', resave: false,
+        saveUninitialized: false, cookie: { secure: shouldUseSecureSessionCookie(undefined),
+            httpOnly: true, sameSite: 'lax' } }));
+    app.get('/', (req, res) => { (req.session as session.Session & { probe?: boolean }).probe = true; res.sendStatus(200); });
+    app.get('/logout', (_req, res) => { clearSessionCookie(res); res.sendStatus(200); });
+    const server = app.listen(0, '127.0.0.1');
+    await new Promise<void>(resolve => server.once('listening', resolve));
+    const address = server.address();
+    assert.ok(address && typeof address === 'object');
+    try {
+        for (const path of ['/', '/logout']) {
+            const response = await fetch(`http://127.0.0.1:${address.port}${path}`);
+            const cookie = response.headers.get('set-cookie') ?? '';
+            assert.match(cookie, /connect\.sid=/);
+            assert.match(cookie, /HttpOnly/);
+            assert.match(cookie, /SameSite=Lax/);
+            assert.doesNotMatch(cookie, /; Secure(?:;|$)/i);
+        }
+    } finally {
+        await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    }
+});
