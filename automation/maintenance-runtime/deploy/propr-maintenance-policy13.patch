@@ -0,0 +1,21 @@
+import { isIP } from 'node:net';
+import { canonicalProprHttpUrlOrigin } from '@propr/shared';
+
+/** Explicit deployment opt-in; never derived from request headers or repository input. */
+export function getInsecureSessionOrigin(): string | undefined {
+    const raw = process.env.AUTH_INSECURE_SESSION_ORIGIN;
+    if (!raw || process.env.COOKIE_DOMAIN) return undefined;
+    if (raw !== process.env.API_PUBLIC_URL || raw !== process.env.FRONTEND_URL) return undefined;
+    try {
+        const url = new URL(raw);
+        if (url.protocol !== 'http:' || url.origin !== raw
+            || canonicalProprHttpUrlOrigin(raw, { allowInsecureHttp: true }) !== raw
+            || isIP(url.hostname) !== 4) return undefined;
+        const [first, second] = url.hostname.split('.').map(Number);
+        const privateAddress = first === 10 || (first === 172 && second >= 16 && second <= 31)
+            || (first === 192 && second === 168);
+        return privateAddress ? raw : undefined;
+    } catch {
+        return undefined;
+    }
+}
