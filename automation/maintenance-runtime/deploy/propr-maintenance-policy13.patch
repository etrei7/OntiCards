+import assert from 'node:assert/strict';
+import { after, mock, test } from 'node:test';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+
+class FakeRedis {
+    status = 'ready';
+    on() { return this; }
+    async eval() { return 0; }
+    async get() { return null; }
+    async quit() { return 'OK'; }
+    disconnect() {}
+}
+mock.module('ioredis', { namedExports: { Redis: FakeRedis, default: FakeRedis } });
+const { executeDockerCommand } = await import('../packages/core/src/claude/docker/dockerExecutor.js');
+const { closeConnection } = await import('../packages/core/src/db/connection.js');
+after(async () => { await closeConnection(); });
+
+test('maintenance instance refuses image builds before launching Docker and still reuses prepared images', async t => {
+    const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'maintenance-image-policy-'));
+    const marker = path.join(directory, 'spawned');
+    await fs.writeFile(path.join(directory, 'docker'), `#!${process.execPath}
+require('node:fs').writeFileSync(${JSON.stringify(marker)}, 'spawned');
+process.stdout.write(JSON.stringify(process.argv.slice(2)));
+`, { mode: 0o755 });
+    const previousPath = process.env.PATH;
+    const previousMode = process.env.ONTICARDS_MAINTENANCE_MODE;
+    process.env.PATH = directory + path.delimiter + previousPath;
+    process.env.ONTICARDS_MAINTENANCE_MODE = '1';
+    t.after(async () => {
+        process.env.PATH = previousPath;
+        if (previousMode === undefined) delete process.env.ONTICARDS_MAINTENANCE_MODE;
+        else process.env.ONTICARDS_MAINTENANCE_MODE = previousMode;
+        await fs.rm(directory, { recursive: true, force: true });
+    });
+    for (const args of [['build', '-t', 'prepared-image', '.'], ['image', 'build', '.'], ['buildx', 'build', '.']]) {
+        await assert.rejects(executeDockerCommand('docker', args), /Build on kol-stage2/);
+        await assert.rejects(fs.access(marker), { code: 'ENOENT' });
+    }
+    for (const args of [['image', 'inspect', 'prepared-image'], ['pull', 'prepared-image']]) {
+        const result = await executeDockerCommand('docker', args);
+        assert.equal(result.exitCode, 0);
+        assert.deepEqual(JSON.parse(result.stdout), args);
+    }
+    delete process.env.ONTICARDS_MAINTENANCE_MODE;
+    const normalBuild = await executeDockerCommand('docker', ['build', '.']);
+    assert.equal(normalBuild.exitCode, 0);
+});
