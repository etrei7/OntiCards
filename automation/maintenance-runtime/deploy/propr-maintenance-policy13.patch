+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import http from 'node:http';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { setTimeout as delay } from 'node:timers/promises';
+import { createHooklessGit, withGitPreparation } from '../packages/core/src/git/hooklessGit.js';
+import { runWithExecutionAbortSignal } from '../packages/core/src/claude/docker/dockerExecutionOwnership.js';
+import { createExecutionDeadline } from '../packages/core/src/claude/docker/dockerExecutionDeadline.js';
+
+type ProcessRow = { pid: number; ppid: number; state: string; comm: string };
+async function processes(): Promise<ProcessRow[]> {
+  const rows: ProcessRow[] = [];
+  for (const name of await fs.readdir('/proc')) {
+    if (!/^\d+$/.test(name)) continue;
+    try {
+      const stat = await fs.readFile(`/proc/${name}/stat`, 'utf8');
+      const end = stat.lastIndexOf(')');
+      const fields = stat.slice(end + 2).split(' ');
+      rows.push({ pid: Number(name), ppid: Number(fields[1]), state: fields[0], comm: stat.slice(stat.indexOf('(') + 1, end) });
+    } catch { /* exited while inspecting */ }
+  }
+  return rows;
+}
+function descendants(rows: ProcessRow[]): ProcessRow[] {
+  const selected = new Set([process.pid]);
+  let changed = true;
+  while (changed) {
+    changed = false;
+    for (const row of rows) if (selected.has(row.ppid) && !selected.has(row.pid)) { selected.add(row.pid); changed = true; }
+  }
+  return rows.filter(row => row.pid !== process.pid && selected.has(row.pid));
+}
+async function stalledClone(mode: 'cancel' | 'deadline' | 'redis-stop' | 'redis-unavailable' | 'preparation-timeout') {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'native-git-prepare-'));
+  const sockets = new Set<import('node:net').Socket>();
+  const ready = Promise.withResolvers<void>();
+  const server = http.createServer(() => ready.resolve());
+  server.on('connection', socket => { sockets.add(socket); socket.on('close', () => sockets.delete(socket)); });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  const url = `http://127.0.0.1:${(server.address() as import('node:net').AddressInfo).port}/source.git`;
+  const controller = new AbortController();
+  const budget = createExecutionDeadline(mode === 'deadline' ? 350 : 5000, controller.signal);
+  let stopped = false;
+  let deleted = 0;
+  let closed = 0;
+  const redisFactory = () => ({
+    get: async (key: string) => {
+      if (stopped && mode === 'redis-unavailable') throw new Error('isolated Redis unavailable');
+      return stopped && key === 'worker:abort:fixture-task' ? 'stop' : null;
+    },
+    del: async () => { deleted++; }, quit: async () => { closed++; }, disconnect() {},
+  });
+  let observed: ProcessRow[] = [];
+  const started = performance.now();
+  const clone = () => createHooklessGit().clone(url, path.join(root, 'clone'));
+  const usingPreparation = mode.startsWith('redis-') || mode === 'preparation-timeout';
+  let failure: Error | undefined;
+  const operation = (usingPreparation
+    ? withGitPreparation('fixture-task', clone, { timeoutMs: mode === 'preparation-timeout' ? 350 : 5000, redisFactory, pollIntervalMs: 15 })
+    : runWithExecutionAbortSignal(budget.executionSignal, clone))
+    .then(() => 'unexpected_success', error => { failure = error; return 'rejected'; });
+  try {
+    await Promise.race([ready.promise, delay(1500).then(() => { throw new Error('real Git HTTP request not observed'); })]);
+    observed = descendants(await processes()).filter(row => row.comm === 'git' || row.comm.startsWith('git-'));
+    assert.ok(observed.some(row => row.comm.startsWith('git-remote-')), 'exercise real Git child, not a mocked promise');
+    if (mode === 'cancel') controller.abort(new Error('test cancellation'));
+    if (mode.startsWith('redis-')) stopped = true;
+    const outcome = await Promise.race([operation, delay(1500).then(() => 'still_running')]);
+    await delay(50);
+    const live = (await processes()).filter(row => observed.some(old => old.pid === row.pid) && row.state !== 'Z');
+    assert.equal(outcome, 'rejected', 'native signal must reach the actual Git process');
+    assert.deepEqual(live, [], 'Git HTTP descendants must terminate');
+    assert.ok(performance.now() - started < 1400, 'phase cancellation must be bounded');
+    if (usingPreparation) {
+      assert.equal(deleted, 0, 'preparation must preserve the shared stop marker');
+      assert.ok(closed >= 2, 'preflight and polling clients must close');
+      if (mode === 'redis-stop') assert.equal(failure?.name, 'ExecutionAbortedError');
+      if (mode === 'redis-unavailable') assert.notEqual(failure?.name, 'ExecutionAbortedError', 'lookup outage is not a user cancellation');
+      if (mode === 'preparation-timeout') assert.match(failure?.message ?? '', /timed out after 350ms/);
+    }
+  } finally {
+    budget.deadline.stop();
+    // Fixture-only cleanup makes the baseline failure safe and cannot mask assertions.
+    const survivors = (await processes()).filter(row => observed.some(old => old.pid === row.pid) && row.state !== 'Z');
+    for (const row of survivors.reverse()) { try { process.kill(row.pid, 'SIGTERM'); } catch {} }
+    for (const socket of sockets) socket.destroy();
+    await new Promise<void>(resolve => server.close(() => resolve()));
+    await operation;
+    await fs.rm(root, { recursive: true, force: true });
+  }
+}
+
+test('task cancellation reaches real clone and HTTP children', () => stalledClone('cancel'));
+test('one native deadline bounds stalled clone and its HTTP children', () => stalledClone('deadline'));
+test('native Redis task stop reaches the preparation clone without consuming its marker', () => stalledClone('redis-stop'));
+test('loss of cancellation state fails closed and stops the real preparation clone', () => stalledClone('redis-unavailable'));
+test('preparation deadline propagates its original timeout after real Git exits', () => stalledClone('preparation-timeout'));
+
+const idleRedis = () => ({ get: async () => null, del: async () => {}, quit: async () => {}, disconnect() {} });
+test('already cancelled task never starts preparation', async () => {
+  let ran = false;
+  await assert.rejects(withGitPreparation('cancelled', async () => { ran = true; }, {
+    redisFactory: () => ({ ...idleRedis(), get: async key => key === 'worker:state:cancelled' ? JSON.stringify({ state: 'cancelled', terminalReason: 'cancelled_by_user' }) : null }),
+  }), { name: 'ExecutionAbortedError' });
+  assert.equal(ran, false);
+});
+test('one deadline spans sequential commands and rejects swallowed timeout before continuing', async () => {
+  let continued = false;
+  await assert.rejects(withGitPreparation('short', async () => {
+    await createHooklessGit().raw(['--version']);
+    await delay(75);
+    await createHooklessGit().raw(['--version']).catch(() => {});
+    // The native boundary must still reject if lower layers tolerate a Git failure.
+  }, { timeoutMs: 50, redisFactory: idleRedis }).then(() => { continued = true; }), /timed out/);
+  assert.equal(continued, false);
+});
+test('successful preparation returns normally and later independent Git remains usable', async () => {
+  const version = await withGitPreparation('success', () => createHooklessGit().raw(['--version']), { redisFactory: idleRedis });
+  assert.match(version, /^git version /);
+  assert.match(await createHooklessGit().raw(['--version']), /^git version /);
+});
+test('expired shared preparation budget cannot start another phase', async () => {
+  let ran = false;
+  await assert.rejects(withGitPreparation('expired', async () => { ran = true; }, { timeoutMs: 0, redisFactory: idleRedis }), /deadline expired/);
+  assert.equal(ran, false);
+});
