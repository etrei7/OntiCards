new file mode 100644
index 0000000..19a6740
--- /dev/null
+++ b/test/liveOutputTtlConfiguration.test.ts
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { execFile } from 'node:child_process';
+import { test } from 'node:test';
+
+// Separate processes exercise startup validation without cached module state or
+// changing another test's environment. No Redis connection is opened on import.
+function loadWithTtl(value: string | undefined): Promise<{ status: number; error?: Error; stdout: string; stderr: string }> {
+    const env = { ...process.env };
+    if (value === undefined) delete env.PROPR_LIVE_OUTPUT_TTL_SECONDS;
+    else env.PROPR_LIVE_OUTPUT_TTL_SECONDS = value;
+    return new Promise(resolve => execFile(process.execPath, ['--import', 'tsx', '--experimental-test-module-mocks', '--input-type=module', '--eval', `
+        const { mock } = await import('node:test');
+        mock.module('./packages/core/src/utils/logger.js', { defaultExport: {} });
+        const { LIVE_OUTPUT_TTL_SECONDS, LIVE_OUTPUT_MAX_BYTES } = await import(
+            './packages/core/src/agents/impl/utils/liveOutputLog.js');
+        console.log(JSON.stringify({ ttl: LIVE_OUTPUT_TTL_SECONDS, maximum: LIVE_OUTPUT_MAX_BYTES }));
+        process.exit(0); // Import-only probe: unrelated logger/runtime handles are outside this test.
+    `], { env, encoding: 'utf8', timeout: 15_000 }, (error, stdout, stderr) => resolve({
+        status: error ? (typeof error.code === 'number' ? error.code : -1) : 0,
+        error: error && typeof error.code !== 'number' ? error : undefined,
+        stdout, stderr,
+    })));
+}
+
+for (const [configured, expected] of [[undefined, 3600], ['60', 60], ['2592000', 2592000], ['31536000', 31536000]] as const) {
+    test(`live output startup accepts ${configured ?? 'unset (upstream default)'} seconds`, async () => {
+        const result = await loadWithTtl(configured);
+        assert.equal(result.error, undefined);
+        assert.equal(result.status, 0, result.stderr);
+        assert.deepEqual(JSON.parse(result.stdout.trim()), { ttl: expected, maximum: 64 * 1024 * 1024 });
+    });
+}
+
+for (const configured of ['', '0', '59', '31536001', '-60', '+60', '60.5', '60.0', '6e1', '0x3c', ' 60', '60 ', '60\n', 'NaN', 'Infinity', '9007199254740993', 'invalid']) {
+    test(`live output startup rejects invalid TTL ${JSON.stringify(configured)}`, async () => {
+        const result = await loadWithTtl(configured);
+        assert.equal(result.error, undefined);
+        assert.notEqual(result.status, 0);
+        assert.equal(result.stdout, '', 'invalid configuration must not produce a usable retention value');
+        assert.match(result.stderr, /PROPR_LIVE_OUTPUT_TTL_SECONDS must be an integer between 60 and 31536000/);
+    });
+}
