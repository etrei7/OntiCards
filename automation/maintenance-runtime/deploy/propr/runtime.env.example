# Public configuration snapshot. Credentials are supplied separately; no model/GitHub/OAuth secret is included.
NODE_ENV=production
LOG_LEVEL=info
ONTICARDS_MAINTENANCE_MODE=1
GH_AUTH_MODE=app
GITHUB_EVENT_INTAKE_MODE=polling
POLLING_INTERVAL_MS=300000
PROPR_CONTAINERIZED=1
PROPR_UI_TUNNEL_ENABLED=false
DB_FILENAME=/usr/src/app/data/propr.sqlite
DATA_DIR=/usr/src/app/data
REDIS_HOST=127.0.0.1
REDIS_PORT=18124
WORKER_CONCURRENCY=1
GITHUB_USER_WHITELIST=stepll2026
PROPR_ADMIN_USERS=stepll2026
GH_PRIVATE_KEY_PATH=/run/propr-secrets/github-app.pem
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=18122
API_PUBLIC_URL=http://10.66.66.5:18123
FRONTEND_URL=http://10.66.66.5:18123
GH_OAUTH_CALLBACK_URL=http://10.66.66.5:18123/api/auth/github/callback
OPENCODE_CONFIG_PATH=/opt/onticards-maintenance/propr/opencode
GIT_CLONES_BASE_PATH=/opt/onticards-maintenance/propr/git/clones
GIT_WORKTREES_BASE_PATH=/opt/onticards-maintenance/propr/git/worktrees
WORKTREE_RETENTION_STRATEGY=always_keep
WORKTREE_RETENTION_HOURS=720
OPENCODE_TIMEOUT_MS=600000
MAX_PROVIDER_REPLACEMENTS=0
AGENT_CONTAINER_MEMORY_LIMIT=4g
AGENT_CONTAINER_CPU_LIMIT=2
AGENT_CONTAINER_PIDS_LIMIT=512
AGENT_NETWORK_MODE=restricted
AGENT_NETWORK_MODE_ENFORCED=true
AGENT_NETWORK_IGNORE_REPOSITORY_ALLOW=true
AGENT_NETWORK_ALLOW=dashscope.aliyuncs.com
PROPR_EGRESS_SOCKET_DIR=/opt/onticards-maintenance/propr/egress
HOST_PROPR_EGRESS_SOCKET_DIR=/opt/onticards-maintenance/propr/egress
HTTP_PROXY=http://127.0.0.1:17891
HTTPS_PROXY=http://127.0.0.1:17891
NO_PROXY=127.0.0.1,localhost,10.66.66.5
GIT_SHALLOW_CLONE_DEPTH=1
AUTH_ALLOW_HTTP_REDIRECT=true
AUTH_INSECURE_SESSION_ORIGIN=http://10.66.66.5:18123
PROPR_TRUSTED_PROXY_PEERS=127.0.0.1,::1
PROPR_LIVE_OUTPUT_TTL_SECONDS=2592000
PRIMARY_PROCESSING_LABELS=AI
OPENCODE_ANALYSIS_ROOT=/opt/onticards-maintenance/propr/git/opencode-analysis
INFRA_LOST_REPLACEMENT=false
