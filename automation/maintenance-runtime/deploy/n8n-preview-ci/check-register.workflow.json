    },
    {
      "id": "04ace1a3-c99a-5eae-9c82-6d4b3aa7865f",
      "name": "Verified registration result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "Verified registration result",
              "leftValue": "={{ [\"watching\",\"invalidated\"].includes($json.state) && !!$json.registration_key }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
