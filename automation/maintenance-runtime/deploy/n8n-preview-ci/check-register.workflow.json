        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "value": "onticards_ci_checks_v1",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "registration_key",
              "condition": "eq",
              "keyValue": "={{ $json.registration_key }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "schema": []
        },
        "options": {}
      },
      "alwaysOutputData": false
    },
    {
      "id": "72d00bc1-4a19-5b27-9926-2ae5200b2896",
