{
  "id": "onticardsPreviewIntakeV1",
  "name": "OntiCards complete existing intake to fixed CI",
  "active": false,
  "nodes": [
    {
      "id": "1d840298-2197-50cc-8e5c-b6f752c5f56e",
      "name": "Trusted complete intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onticards-preview-intake-v1",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "onticardsPreviewTrigger",
          "name": "onticards-preview-trigger"
        }
      },
      "webhookId": "onticards-preview-intake-v1"
    },
    {
      "id": "96a2cb42-24c2-5378-9b76-effc2dceb10c",
      "name": "Validate complete existing snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json.body??{},mode=p.mode??'dispatch';\nconst observed=Date.parse(p.observed_at),watermark=Date.parse(p.watermark);\nif(p.source!=='onticards_intake_threads_v1'||p.complete!==true||p.token_revoked!==true||!['dispatch','dry_run'].includes(mode)||!Number.isFinite(observed)||!Number.isFinite(watermark)||observed>Date.now()+300000||Date.now()-observed>900000||watermark>observed+300000||!Array.isArray(p.threads)||p.threads.length>20)throw new Error('Incomplete, stale, oversized or unauthorized intake snapshot');\nconst seen=new Set();return p.threads.map(t=>{\nif(!Number.isSafeInteger(t.pr)||t.pr<1||t.pr>9999999||t.state!=='open'||!/^[a-f0-9]{40}$/.test(t.head??'')||!/^[a-f0-9]{40}$/.test(t.base??'')||seen.has(t.pr))throw new Error('Invalid or duplicate fixed PR candidate');seen.add(t.pr);\nreturn {json:{pr:t.pr,head:t.head,base:t.base,mode,watermark:p.watermark,observed_at:p.observed_at}};});"
      }
    },
    {
      "id": "ac39cdc4-c3e2-5d8f-b975-6e02e4693dad",
      "name": "Read existing batch CI receipts",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "onticards_ci_receipts_v1",
          "mode": "name"
        },
        "returnAll": true
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "40ec3ba5-daba-5eb2-bfd0-3178e8b5d377",
      "name": "Select bounded unseen batch budget need",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const candidates=$('Validate complete existing snapshot').all().map(x=>x.json),rows=$('Read existing batch CI receipts').all().map(x=>x.json);\nconst consumed=new Set(rows.map(x=>x.receipt_key).filter(x=>typeof x==='string'));\nconst needed=candidates.some(p=>p.mode==='dispatch'&&!consumed.has(`stepll2026/OntiCards#${p.pr}:${p.head}:${p.base}`)&&!consumed.has(`admission:stepll2026/OntiCards#${p.pr}:${p.head}:${p.base}`));\nreturn [{json:{needed,candidates}}];"
      }
    },
    {
      "id": "49f00a41-8aad-5dd7-8b44-ae102436706c",
      "name": "Only unseen real batch needs balance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "Only unseen real batch needs balance",
              "leftValue": "={{ $json.needed === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c79445fe-4f14-5031-bc30-60eafdc1870a",
      "name": "Read one native balance per complete batch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "executeOnce": true,
        "command": "node /opt/onticards-preview-ci/bundle/budget_status.mjs"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "52e0564f-7995-5361-8a4e-de8e8dd956f7",
      "name": "Skip balance for dry run or consumed batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{stdout:JSON.stringify({state:'not_required',checked_at:new Date().toISOString(),token_creation_calls:0,provider_calls:0})}}];"
      }
    },
    {
      "id": "11aef8bc-99d7-5564-bfbb-0b2990772486",
      "name": "Bind native observation to exact batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const p=$('Select bounded unseen batch budget need').first().json;let raw;try{raw=JSON.parse($input.first().json.stdout??'');}catch{raw={state:'budget_unverifiable'};}\nconst budget={state:raw.state,required_quota:raw.required_quota,remaining_quota:raw.remaining_quota,checked_at:raw.checked_at,provider_calls:raw.provider_calls,token_creation_calls:raw.token_creation_calls,account_quota_reset:raw.account_quota_reset,reason_code:raw.reason_code??null};\nreturn p.candidates.map(c=>({json:{...c,batch_budget:{...budget,watermark:c.watermark,observed_at:c.observed_at}}}));"
      }
    },
    {
      "id": "bffc0298-387b-58b2-b848-f067444480f6",
      "name": "Native exact version admission",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "onticardsPreviewAdmissionV1",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "be14f17b-1132-581a-8050-1af83264e80f",
      "name": "Safe dispatch receipt projection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(x=>({json:x.json}));"
      }
    }
  ],
