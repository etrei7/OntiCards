      "parameters": {
        "jsCode": "const p=$('Validate fixed revision input').first().json,res=$input.first().json,r=res.body;\nconst current=res.statusCode===200&&r?.state==='open'&&r.head?.repo?.full_name==='stepll2026/OntiCards'&&r.base?.repo?.full_name==='stepll2026/OntiCards'&&r.head?.ref?.startsWith('codex/')&&r.base.ref==='main'&&r.head.sha===p.head&&r.base.sha===p.base;\nreturn [{json:{...p,current,http_status:res.statusCode??null,observed_head:r?.head?.sha??null,observed_base:r?.base?.sha??null,reason:current?'exact_current_revision':'stale_or_remote_unverifiable',checked_at:new Date().toISOString()}}];"
      }
    },
