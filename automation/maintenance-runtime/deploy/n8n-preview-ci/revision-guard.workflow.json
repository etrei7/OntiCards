        220,
        0
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json;\nif(!Number.isSafeInteger(p.pr)||p.pr<1||p.pr>9999999||!/^[a-f0-9]{40}$/.test(p.head??'')||!/^[a-f0-9]{40}$/.test(p.base??''))throw new Error('Invalid fixed revision');\nreturn [{json:{pr:p.pr,head:p.head,base:p.base}}];"
      }
