        },
        "options": {}
      }
    },
    {
      "id": "44093b21-3be7-5efa-9ad4-d8a06fa39253",
      "name": "Safe review receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3960,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(x=>({json:x.json}));"
      }
    }
