          },
          "conditions": [
            {
              "id": "Store only real terminal observation",
              "leftValue": "={{ $('Set fixed native key').first().json.mode === 'review' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c8c6dedc-e968-5ecc-9649-b4f700971fd6",
      "name": "Dry probe cannot consume real admission",
