      ],
      "parameters": {
        "jsCode": "const p=$('Preserve fresh scope verdict').first().json;const b=p.batch_budget,age=Date.now()-Date.parse(b?.checked_at);\nconst valid=b&&b.watermark===p.watermark&&b.observed_at===p.observed_at&&Number.isFinite(age)&&age>=-5000&&age<=300000&&b.required_quota===45000&&b.provider_calls===0&&b.token_creation_calls===0&&b.account_quota_reset===false&&Number.isSafeInteger(b.remaining_quota)&&b.remaining_quota>=0;\nconst budget=valid?b:{state:'budget_unverifiable',reason_code:'batch_observation_stale_missing_or_mismatched',provider_calls:0,token_creation_calls:0};\nconst allowed=valid&&budget.state==='budget_available'&&budget.remaining_quota>=budget.required_quota;\nreturn [{json:{...p,budget,allowed,state:allowed?'dispatching':budget.state==='budget_exhausted'?'budget_exhausted':'budget_unverifiable'}}];"
      }
