        "jsonOutput": "={{ (()=>{const cfg=$('Trusted semantic policy').first().json,conversations=$('Read review conversation budgets').all().map(x=>x.json),prior=$('Read prior semantic reservations').all().map(x=>x.json);const eligible=[];for(const row of $('Read original structured drafts').all().map(x=>x.json)){if(!row.event_key||row.status!=='awaiting_semantic_review'||!['咨询','缺信息'].includes(row.classification)||prior.some(p=>p.event_key===row.event_key))continue;const s=JSON.parse(row.source_snapshot||'{}'),d=JSON.parse(row.draft||'{}'),c=conversations.find(v=>v.thread_key===row.thread_key);if(!c||c.pending_event!==row.event_key||c.pending_state!=='model_request_started'||Number(c.model_calls)>=cfg.max_model_calls_per_thread||Number(c.reply_count)>=3)continue;if(cfg.manual_handoff_threads.includes(s.number)||s.repository!==cfg.repository||s.thread_key!==row.thread_key||s.event?.author_type!=='User'||!s.repository_context?.complete||!s.repository_context?.token_revoked||(!Number.isFinite(Date.parse(s.source_watermark||''))||Date.now()-Date.parse(s.source_watermark)>cfg.freshness_seconds*1000))continue;eligible.push({row,source:s,draft:d,conversation:c});}const candidate=eligible[0]||null;return {candidate,enabled:cfg.review_enabled===true,eligible_count:eligible.length,model_calls:0,github_posts:0};})() }}",
