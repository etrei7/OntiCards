[Unit]
Description=OntiCards repository collector (%i)
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
Type=oneshot
User=onticards-report
Group=onticards-report
WorkingDirectory=/opt/onticards-maintenance/reporting
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
EnvironmentFile=/opt/onticards-maintenance/proxy.env
EnvironmentFile=-/opt/onticards-maintenance/reporting.env
EnvironmentFile=-/opt/onticards-maintenance/secrets/reporting-github.env
ExecStart=/usr/bin/flock --wait 60 --conflict-exit-code 75 /var/lib/onticards-report/collector.lock /opt/onticards-maintenance/reporting/.venv/bin/python -m onticards.report %i --state /var/lib/onticards-report --recover-interrupted
TimeoutStartSec=15min
TimeoutStopSec=20s
Restart=no
StateDirectory=onticards-report
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/opt/onticards-maintenance/secrets
